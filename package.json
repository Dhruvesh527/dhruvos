{
  "name": "dhruvos-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "node node_modules/next/dist/bin/next build && node scripts/fix-prefetch.mjs",
    "start": "node scripts/preview.mjs",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-export.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "playwright-core": "^1.65.0",
    "typescript": "5.9.3"
  }
}
